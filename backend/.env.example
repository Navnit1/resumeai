# ─── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────
MONGODB_URI=mongodb+srv://Navnit:Navnit123@cluster0.gj5wp4e.mongodb.net/?appName=Cluster0
# Production: mongodb+srv://user:pass@cluster.mongodb.net/resumeai

# ─── JWT ─────────────────────────────────────────
JWT_SECRET=your_super_secure_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-...your_openai_key_here

# ─── Cloudinary ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (optional, for password reset) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=ResumeAI <noreply@resumeai.dev>
